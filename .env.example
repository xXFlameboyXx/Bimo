# =================================================================
# Bimo Configuration Environment Variables
# =================================================================

# Robot Identity & Mode
ROBOT_NAME="Bimo"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Display Configuration (800x480 native face sprites)
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480
DISPLAY_BACKEND="simulator" # Options: simulator, spi_st7789, spi_ili9486
IDLE_ROTATION_SECONDS=300.0   # Duration to display each idle sub-category before rotating

# AI / LLM Configuration (OmniRoute / Gemini Flash)
LLM_PROVIDER="omniroute"
OMNIROUTE_BASE_URL="http://localhost:20128"
LLM_MODEL="gemini-3.8-flash"
LLM_API_KEY=""
LLM_TIMEOUT=30.0
LLM_MAX_HISTORY=20

# Laptop External Node (Optional device)
ENABLE_LAPTOP_CONTROL=false
LAPTOP_HOST="192.168.1.50"
LAPTOP_PORT=8088

# Audio & Voice Pipeline (Phase 3, 3.5 & 4)
AUDIO_INPUT="pc"                  # Options: pc, mock, pi
AUDIO_OUTPUT="windows"            # Options: windows, mock, pi
STT_PROVIDER="whisper"            # Options: whisper, google, mock
WHISPER_MODEL="base.en"           # Options: base.en (recommended accurate), tiny.en (minimal RAM)
WHISPER_MODEL_PATH=""             # Optional local model path or directory

# Wake Word Detection Configuration (Multi-Wake-Word)
WAKE_WORD_PROVIDER="openwakeword" # Options: openwakeword, mock
# Any configured wake word can activate Bimo.
# Add/remove models by editing this comma-separated list.
# Custom trained models (e.g. models/hey_bimo.onnx) can be included in this list.
WAKE_WORD_MODELS="hey_jarvis,alexa,hey_mycroft"
WAKE_WORD_MODEL="hey_jarvis"      # Legacy singular fallback (optional)
WAKE_WORD_THRESHOLD=0.5           # Confidence threshold (0.0 - 1.0)
WAKE_WORD_COOLDOWN=1.5            # Cooldown seconds between detections to avoid repeat triggers
SPEECH_TIMEOUT=5.0                # Seconds to wait for speech start after wake word
MAX_SPEECH_DURATION=10.0          # Max speech capture length in seconds before transcription
AUDIO_ENERGY_THRESHOLD=110.0      # Energy threshold for VAD voice activity detection
AUDIO_SILENCE_SECONDS=1.25        # Silence duration in seconds indicating speech end

# Text-To-Speech (TTS) Configuration (Phase 4: Piper Neural TTS)
TTS_PROVIDER="piper"              # Options: piper, windows, mock, pi
# Selected default voice is Piper en_GB-semaine-medium:
PIPER_MODEL_PATH="models/piper/en_GB-semaine-medium.onnx"
PIPER_CONFIG_PATH="models/piper/en_GB-semaine-medium.onnx.json"
TTS_OUTPUT_DEVICE="default"       # Audio output device index or name
TTS_SAMPLE_RATE=22050             # Piper native sample rate
TTS_VOICE="en_GB-semaine-medium"  # Configured voice identifier
TTS_SPEECH_RATE=175               # Words per minute (mapped to Piper length_scale)
TTS_VOLUME=1.0                    # Volume from 0.0 to 1.0

# Windows PC Agent & Controlled Computer Use (Phase 7 & Phase 8)
PC_AGENT_ENABLED=true
PC_AGENT_HOST="127.0.0.1"          # LAN IP or hostname of target Windows PC (e.g. 192.168.1.50)
PC_AGENT_PORT=8088
PC_AGENT_SHARED_SECRET="replace-with-a-secure-random-hmac-secret-min-32-chars"
PC_AGENT_CONNECT_TIMEOUT=3.0
PC_AGENT_REQUEST_TIMEOUT=10.0

# Computer-Use Bounds & Visual Capture Limits (Phase 8)
COMPUTER_USE_ENABLED=true
MAX_COMPUTER_USE_STEPS=12          # Multi-turn computer-use iteration limit
PC_SCREENSHOT_MAX_WIDTH=1920
PC_SCREENSHOT_MAX_HEIGHT=1080
PC_SCREENSHOT_MAX_BYTES=1500000    # Strict 1.5MB limit on screenshot payload
PC_MAX_TYPE_TEXT_LENGTH=1000       # Max characters typed per command
PC_MAX_SCROLL=1000                 # Max scroll delta per command
